# Kompilier-Cache von OpenVINO (mehrere GB, wird automatisch neu erzeugt)
.ov_cache/
# Laufzeitdaten
logs/
aufnahmen/
__pycache__/
*.pyc
# Audio (Sprachaufnahmen bleiben lokal, nicht in die Versionskontrolle)
*.wav

# Persönliche Dateien (werden beim ersten Start aus den *.beispiel-Vorlagen angelegt)
config.toml
fachwoerter.txt
befehle.toml
textfelder.toml
# Plan-Ausführung (Arbeitsbereich der Superpowers-Skills)
.superpowers/
# Verknüpfungen zeigen auf rechnerabhängige Pfade, install.ps1 legt sie an
*.lnk
# Projektnotizen, Messungen und Experimente des Entwicklers (enthalten interne Diktate)
CLAUDE.local.md
MEMORY.md
PLAN.md
whisper-test/
.claude/settings.local.json
# Planungsnotizen der Entwicklung (Specs/Pläne mit internen Details)
docs/superpowers/
